# D:\empresas\catalogo\.env.example 
# ---- Entorno / Next ----
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Base de datos (Prisma) ----
# SQLite recomendado para dev (ruta relativa dentro del repo)
DATABASE_URL="file:./prisma/data/dev.db"
# Para Postgres/Maria/MySQL, reemplazar por tu cadena real:
# DATABASE_URL="postgresql://user:pass@localhost:5432/catalogo"

# ---- Auth: usuario final (sesión) ----
USER_COOKIE_NAME=user_session
USER_SESSION_TTL_DAYS=7
PASSWORD_SALT_ROUNDS=10

# ---- Auth: admin (backoffice) ----
# IMPORTANTE: cambiá estos valores en tu entorno real
ADMIN_TOKEN=change_me_please_generate_a_long_random_token
ADMIN_EMAIL=admin@local.test
ADMIN_PASSWORD=admin_password_seguro
AUTH_COOKIE_NAME=admin_token

# ---- Multi-tenant / defaults ----
DEFAULT_TENANT_ID=default

# ---- Integraciones de pago (opcional) ----
# Mercado Pago
MP_ACCESS_TOKEN=
MP_INTEGRATOR_ID=
MP_NOTIFICATION_URL=${NEXT_PUBLIC_SITE_URL}/api/webhooks/mercadopago

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=ARS
STRIPE_SUCCESS_URL=${NEXT_PUBLIC_SITE_URL}/checkout/success
STRIPE_CANCEL_URL=${NEXT_PUBLIC_SITE_URL}/checkout/cancel

# ---- Proveedores "redirect" (si los usás) ----
REDIRECT_QR_URL=${NEXT_PUBLIC_SITE_URL}/api/checkout/providers/redirect
REDIRECT_PAGOS360_URL=${NEXT_PUBLIC_SITE_URL}/api/checkout/providers/redirect
REDIRECT_TODOPAGO_URL=${NEXT_PUBLIC_SITE_URL}/api/checkout/providers/redirect
REDIRECT_PAYU_URL=${NEXT_PUBLIC_SITE_URL}/api/checkout/providers/redirect
REDIRECT_MOBBEX_URL=${NEXT_PUBLIC_SITE_URL}/api/checkout/providers/redirect

# ---- Rutas de gestión local (opcional) ----
GESTION_EXCEL_PATH=D:\empresas\ferreluc\gestion\listas\normalizadas\grais\data.xlsx
GESTION_JSON_DIR=D:\empresas\ferreluc\gestion\json
GESTION_JSON_PATH=D:\empresas\ferreluc\gestion\json\producto_grais.json
GESTION_IMGS_DIR=D:\empresas\ferreluc\gestion\imagenes
